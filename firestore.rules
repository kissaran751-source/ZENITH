rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("uid", "") == "1000" ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "") == "SUPER_ADMIN"));
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /meta/{doc} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
      
      match /dailyLogs/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
      match /sugarLogs/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
      match /ai_insights/{insightId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
      match /coinTransactions/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
    }

    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.firebaseUid == request.auth.uid;
      allow read: if isAdmin();
      allow update: if isAdmin();
    }

    match /gifts/{giftId} {
      allow read: if request.auth != null && resource.data.toFirebaseUid == request.auth.uid;
      allow read: if isAdmin();
      allow create, update: if request.auth != null && resource.data.toFirebaseUid == request.auth.uid;
      allow create, update: if isAdmin();
    }
    
    match /store_items/{itemId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || true; // allow seed for now
    }

    match /transactions/{txId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow list: if request.auth != null; // Relax for demo, rely on client side query
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /{document=**} {
      allow read, write: if false; 
    }
  }
}
